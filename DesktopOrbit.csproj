<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\orbital-launcher.ico</ApplicationIcon>
    <AssemblyName>OrbitalLauncher</AssemblyName>
    <Product>Orbital Launcher</Product>
    <Version>2.0.1</Version>
    <Copyright>Copyright (c) 2026 debattistacliff-commits. All rights reserved.</Copyright>
    <Authors>debattistacliff-commits</Authors>
    <Description>A frosted-glass ring launcher for Windows: apps, social accounts, folders, world radio and quick system actions, opened with Alt+Space or the desktop right-click menu.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\orbital-launcher.ico" />
    <Resource Include="Assets\orbital-launcher.png" />
    <Resource Include="Assets\flag-wales.png" />
    <Resource Include="Assets\flag-portugal.png" />
    <Resource Include="Assets\flag-spain.png" />
    <Resource Include="Assets\flag-malta.png" />
    <Resource Include="Assets\flags\*.png" />
    <Resource Include="Assets\flags\index.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

</Project>
